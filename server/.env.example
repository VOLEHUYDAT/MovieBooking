# Copy to server/.env and fill in. Never commit the real .env file.

NODE_ENV=development
PORT=4000

# Supabase Postgres connection string:
#   Supabase Dashboard -> Project -> Connect -> "Session pooler" (IPv4) connection string.
#   Replace [YOUR-PASSWORD] with your database password.
# Leave empty to use the embedded PGlite database in ./.pglite (no setup needed).
DATABASE_URL=
# auto = TLS for any non-localhost host (required by Supabase)
DATABASE_SSL=auto

# Origin of the web app (only needed when it is not served through the Vite proxy)
CLIENT_ORIGIN=http://localhost:5173

# Seed demo accounts and bookings on first start (defaults to true outside production)
SEED_DEMO_DATA=true
